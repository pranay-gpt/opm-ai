# OPM-AI Environment Configuration

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_NIM_API=your_nvidia_nim_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# LLM Provider: "groq" | "openai" | "offline"
LLM_PROVIDER=offline

# Optional: Tavily API for web search
TAVILY_API=your_tavily_api_key_here

# OPM Flow binary path
OPM_FLOW_BINARY=/usr/bin/flow

# ResInsight gRPC port
RESINSIGHT_GRPC_PORT=50051

# ResInsight executable path
RESINSIGHT_EXECUTABLE=/usr/bin/ResInsight

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# Reference decks
FIXTURES_PATH=tests/fixtures

# Logging
LOG_LEVEL=INFO