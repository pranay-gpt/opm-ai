# OPM-AI Environment Variables
# Copy to .env and fill in your API keys

# LLM Provider (options: groq, openai, nim, auto, offline)
# "offline" (default) never makes network calls even if keys are set.
LLM_PROVIDER=offline

# Groq API (get from https://console.groq.com)
GROQ_API_KEY=

# NVIDIA NIM API (get from https://build.nvidia.com)
NVIDIA_NIM_API=

# OpenAI API (get from https://platform.openai.com)
OPENAI_API_KEY=

# OPM Flow binary path (inside container: /usr/bin/flow)
OPM_FLOW_BINARY=/usr/bin/flow

# ResInsight (optional, 3D snapshots; host-only: needs a live X display,
# the packaged ResInsight has no gRPC so snapshots do not work inside Docker)
RESINSIGHT_EXECUTABLE=/usr/bin/ResInsight

# Optional: extra directory the deck browser (GET /api/files) may list and
# /api/run may load from, for a deck library kept outside tests/fixtures and
# /app/decks. Unset by default because it widens what the API will read.
# OPM_DECKS_ROOT=/path/to/your/decks

# Optional: Custom API host/port
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO