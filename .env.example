# OPM-AI Environment Variables
# Copy to .env and fill in your API keys

# LLM Provider (options: groq, openai, nvidia, offline)
LLM_PROVIDER=offline

# Groq API (get from https://console.groq.com)
GROQ_API_KEY=

# NVIDIA API (get from https://build.nvidia.com)
NVIDIA_API_KEY=

# OpenAI API (get from https://platform.openai.com)
OPENAI_API_KEY=

# OPM Flow binary path (inside container: /usr/bin/flow)
OPM_FLOW_BINARY=/usr/bin/flow

# ResInsight gRPC (optional, for visualization)
RESINSIGHT_HOST=resinsight
RESINSIGHT_GRPC_PORT=50051

# Optional: Custom API host/port
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO