--  surfactant      water
--  concentration   viscosity
--  kg/sm3          cP
     0.0            0.5
    20.0            5.0 /

--  water/oil surface tension versus surfactant concentration
SURFST
--  surfactant      water-oil
--  concentration   surface tension
--  kg/sm3          N/m
    0.0             9.
    1.0             1e-5
    20.0            1e-8    /

--  surfactant capillary de-saturation functions
SURFCAPD
--  log10 of the        miscibility
--  capillary number    function
    -20                 0.0
    -7                  0.0
    -4                  1.0
     10                 1.0 /
/   --  default the second table to the first one

--  specifies the surfactant-rock properties
SURFROCK
--  desorption              mass density
--  index                   of the rock
--  desorption allowed      kg/rm3
    1                       / -- 2500.   /
/   -- default the second table to the first one

--  analytical adsorption function
ADSORP
    SURFACT /
--  isotherm    a1          a2      b       m   n   K_{ref}
    LANGMUIR    1e-4        2e-5    4.      1.  0.  1200.    /
/   --  default the second table to the first one


----------------------------------------------------------------------
--  ALKALINE KEYWORDS

--  water/oil surface tension multipliers
--  as a function of alkaline concentration
ALSURFST
--  alkaline             water/oil surface tension
--  concentration        multiplier
--  kg/sm3
    0.0                  1.0
    2.0                  0.8
    5.0                  0.7
    7.0                  0.5
   10.0                  0.1   /

--  analytical adsorption function
ADSORP
    ALKALINE /
--  units:
--      a1: (sm3/kg)^m
--      a2: (sm3)^{m+1}/(kg^m kMole) or (sm3/kg)^{m+1} see ref manual
--      b:  sm3/kg
--      m:  [-]
--      n:  [-]
--      K_{ref}:    mDarcy
--
--  isotherm    a1          a2      b       m   n   K_{ref}
    LANGMUIR    1e-4        2e-5    4       1.  0.  1200.    /
/   --  default the second table to the first one

--  surfactant adsorption multipliers
--  as a function of alkaline concentration
ALSURFAD
--  alkaline             adsorption
--  concentration        multiplier
--  in solution
--  kg/sm3
      0.0                 1.0
      2.0                 0.2
     10.0                 0.1
     20.0                 0.05 /
/   -- default the second table to the first one

--  polymer adsorption multipliers
--  as a function of alkaline concentration
ALPOLADS
--  alkaline             adsorption
--  concentration        multiplier
--  in solution
--  kg/sm3
      0.0                1.0
      2.0                0.2
     10.0                0.1
     20.0                0.05 /
/   -- default the second table to the first one

--  alkaline desorption
ALKROCK
    1 /
/   -- default the second table to the first one


----------------------------------------------------------------------
--  POLYMER KEYWORDS

--  salt concentration (kg/sm3) for the PLYVISCS 2D table
SALTNODE
     5. 20. 40. /

--  polymer solution viscosity
PLYVISCS
--  polymer         water viscosity
--  concentration   multiplier
--  kg/sm3          [-]
--           Csalt  5  20  40 from SALTNODE
      0.             1.  1.  1. /   --  for Cpoly = 0. kg/cm3
      1.             5.  5.  5. /   --  for Cpoly = 1. kg/cm3
      2.             20.  20.  20. /   --  for Cpoly = 2. kg/cm3
/

SHRATE
  0.00000343  /

--  shear thinning-thickening
PLYSHLOG
-- Reference Conditions
-- Poly  Salt  Temp
   0.5   30.0  1*  /
--  water       shear
--  shear rate  effect
--  1/day       multiplier
     0.0000000001  1.0
     0.1           0.95
     1.0           0.8
    10.0           0.775
   100.0           0.85
  1000.0           1.125 /

--  polymer-rock properties
PLYROCK
--  dead    residual    mass    adsorption  maximum
--  pore    resistance  density index       polymer
--  space   factor      kg/rm3  desorp      adsorption
    0.16    1.7         2500.0  1           .00005  /
    0.16    1.7         2500.0  1           .00005  /

--  analytical adsorption function
ADSORP
    POLYMER /
--  units:
--      a1: (sm3/kg)^m
--      a2: (sm3)^{m+1}/(kg^m kMole) or (sm3/kg)^{m+1} see ref manual
--      b:  sm3/kg
--      m:  [-]
--      n:  [-]
--      K_{ref}:    mDarcy
--
--  isotherm    a1          a2      b       m   n   K_{ref}
    LANGMUIR    2e-5        2e-6    4       1.  0.  1200.    /
/   --  default the second table to the first one

--  polymer-salt concentrations for mixing calculations
--  maximum polymer and salt concentrations
PLYMAX
--  polymer         salt
--  concentration   concentration
--  kg/sm3          kg/sm3
    1.7             0.  /

--  Todd-Longstaff mixing parameter
PLMIXPAR
    1.  /

